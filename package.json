{
  "name": "petsitter",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run shared:check && npm run a11y:check && npm run lint && npm run format:check && npm run typecheck && npm test",
    "mobile": "npm run start -w @petsitter/mobile",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node scripts/gen-types.mjs",
    "shared:sync": "node scripts/sync-shared.mjs",
    "shared:check": "node scripts/sync-shared.mjs --check",
    "web": "npm run dev -w @petsitter/admin-web",
    "web:build": "npm run build -w @petsitter/admin-web",
    "functions:check": "node scripts/check-functions.mjs",
    "secrets:check": "node scripts/check-bundle-secrets.mjs",
    "a11y:check": "node scripts/check-a11y.mjs",
    "e2e": "maestro test apps/mobile/.maestro"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10"
  }
}
