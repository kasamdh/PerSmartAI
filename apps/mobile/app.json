{
  "expo": {
    "name": "PetSitter",
    "slug": "PetSitter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petsitter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kasamdh.petsitter",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.kasamdh.petsitter",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pet Sitter records your location when you check in and out of a visit, so owners know you arrived."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Pet Sitter uses the camera so you can send visit photos to pet owners.",
          "photosPermission": "Pet Sitter lets you choose photos to send to pet owners."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Pet Sitter uses the camera so you can send visit photos and videos to pet owners.",
          "microphonePermission": "Pet Sitter records sound with visit videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Pet Sitter saves visit photos and videos to your library when you ask.",
          "savePhotosPermission": "Pet Sitter saves visit photos and videos to your library when you ask.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@sentry/react-native",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "kasamdh",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f9b57530-6b8c-44f2-8a16-d1c2d659cfd4"
      }
    }
  }
}
