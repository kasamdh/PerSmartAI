# Copy to .env and fill in. Never commit .env.
# Hosted: Supabase Dashboard > Project Settings > API. Local: `npx supabase status`.
# Only the anon/public key goes here. NEVER put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Admin site address; the app links to its /privacy and /terms pages.
EXPO_PUBLIC_LEGAL_URL=http://localhost:3001
